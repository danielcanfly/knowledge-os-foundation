      "quote": "2. Context & Capability Plane\n   Knowledge\n   Memory\n   Skills\n   Workspace\n   Tools\n   MCP / Native capability transport\n   Context Compiler",
      "transport_allowed_only_after_live_revalidation": true
    },
    {
