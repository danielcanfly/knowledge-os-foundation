      "quote_sha256": "0de3fbd17d2e82e90f905bd3d6cd95eed6544cfb6d30a305f54c58e0a1ee7e0e",
      "quote": "- a rewrite of M26\n- a generic multi-agent swarm\n- an MCP-first system\n- a Jev-dependent system\n- a LangGraph / Agents SDK wrapper\n- a replacement for Qdrant, R2, citations, ACL, release, or evals",
      "transport_allowed_only_after_live_revalidation": true
    },
    {
