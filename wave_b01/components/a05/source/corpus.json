      "quote_sha256": "ca7e82aec2070abd82e6342869544a2dce85546ec3fecde19b241ab32a26c48c",
      "quote": "M27 upgrades the current M26 Knowledge Engine into a context-native runtime that can plan context, select capabilities, allocate compute, verify outputs, and learn from traces without weakening deterministic governance.",
      "transport_allowed_only_after_live_revalidation": true
    },
    {
      "passage_id": "D00P001",
      "doc_id": "D00",
      "source_filename": "00_m27_architecture_overview.md",
      "source_sha256": "044c03b3d8ad38ac0a22a734a2469629c132499cce5c43d49138d703a5ffca1d",
