E           @dataclass(frozen=True, slots=True)
E           class M27ExecutableRequest:
E               """Explicit isolated route with synthetic or pinned production-equivalent evidence."""
E           
E               question: str
E               evidence_catalog: Mapping[str, Mapping[str, Any]]
E               compiler_policy: Mapping[str, Any]
E               semantic_provider: object
E               production_evidence_authority: ProductionEvidenceAuthority | None = None
E               requirements: Sequence[object] = ()
E               intent_class: str = "direct_grounded_knowledge"
E               endpoint_proof: Mapping[str, Any] | None = None
E               event_sink: Callable[[Mapping[str, Any]], None] | None = None
