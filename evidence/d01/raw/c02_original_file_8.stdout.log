E           
E           class ProviderQuota:
E               """Enforce caller's provider allowance across M26 internal verification calls."""
E           
E               def __init__(self, provider: object, *, max_calls: int, deadline_at: float) -> None:
E                   self._provider = provider
E                   self.max_calls = max_calls
E                   self.deadline_at = deadline_at
E                   self.calls = 0
E                   self.telemetry: list[ProviderCallTelemetry] = []
E           
E               def call(self, payload: Mapping[str, Any], call_class: str) -> object:
E                   if self.calls >= self.max_calls or time.monotonic() >= self.deadline_at:
E                       raise ProviderQuotaExhausted("isolated M27 provider budget exhausted")
E                   self.calls += 1
E                   start_ns = time.perf_counter_ns()
E                   try:
E                       result = self._provider.call(payload, call_class)
E                   except Exception as exc:
E                       self.telemetry.append(
E                           ProviderCallTelemetry(
E                               call_index=self.calls,
E                               call_class=call_class,
E                               latency_ms=elapsed_ms(start_ns, time.perf_counter_ns()),
E                               success=False,
E                               reason_code="PROVIDER_EXCEPTION_UNKNOWN_EFFECT",
E                           )
E                       )
E                       # An exception does not prove that the call had no effect.
E                       # Consume the remaining grant and refuse any local retry.
E                       self.max_calls = self.calls
E                       raise SemanticProviderUnavailable(
E                           "provider result unavailable; retries prohibited after uncertain effect"
E                       ) from exc
E                   self.telemetry.append(
E                       ProviderCallTelemetry(
E                           call_index=self.calls,
E                           call_class=call_class,
E                           latency_ms=elapsed_ms(start_ns, time.perf_counter_ns()),
E                           success=True,
E                           reason_code="PROVIDER_CALL_OK",
E                       )
E                   )
E                   return result
E           
E           
E           def _evidence_authority(request: M27ExecutableRequest) -> str:
E               if request.production_evidence_authority is not None:
E                   return "production_equivalent"
E               return "synthetic_only"
