E           
E           def _verification_citations_are_selected(
E               verification: Mapping[str, Any],
E               selected: Sequence[Mapping[str, Any]],
E           ) -> bool:
E               selected_locators = {str(item.get("locator_id") or "") for item in selected}
E               selected_evidence_ids = {str(item.get("evidence_id") or "") for item in selected}
E               citations = verification.get("citations")
E               if not isinstance(citations, Sequence) or isinstance(citations, (str, bytes)):
E                   return False
E               for citation in citations:
E                   if not isinstance(citation, Mapping):
E                       return False
E                   locator_id = str(citation.get("locator_id") or "")
E                   evidence_id = str(citation.get("evidence_id") or "")
E                   if locator_id and locator_id not in selected_locators:
E                       return False
E                   if evidence_id and evidence_id not in selected_evidence_ids:
E                       return False
E               return True
E           
E           
E           # Production evidence can have a valid immutable citation binding while a
E           # provider incorrectly labels an unrelated proposition as "ENTAILED".
E           # This is a deliberately conservative NECESSARY lexical grounding check,
E           # not a substitute for the semantic verifier. Unsupported content fails
E           # closed; unfamiliar paraphrases may abstain rather than be over-admitted.
E           _PRODUCTION_GROUNDING_STOP = frozenset({
E               "a", "an", "and", "are", "as", "at", "be", "been", "by", "do",
E               "does", "for", "from", "has", "have", "in", "into", "is", "it",
E               "of", "on", "or", "that", "the", "their", "this", "to", "was",
E               "were", "which", "with",
E           })
E           _PRODUCTION_GROUNDING_EQUIVALENT = {
E               "keeps": "store", "keep": "store", "kept": "store",
E               "stores": "store", "stored": "store", "storage": "store",
E               "analyzes": "analysis", "analyze": "analysis",
E               "analyzing": "analysis", "analyses": "analysis",
E               "analytics": "analysis", "analytical": "analysis",
E               "supports": "support", "supported": "support",
E           }
E           
E           
E           def _production_grounding_terms(value: str) -> set[str]:
E               return {
E                   _PRODUCTION_GROUNDING_EQUIVALENT.get(term, term)
E                   for term in re.findall(r"[a-z0-9]+|[\u3400-\u9fff]+", value.casefold())
E                   if term not in _PRODUCTION_GROUNDING_STOP
E               }
E           
E           
E           def _production_claims_lexically_grounded(
E               verification: Mapping[str, Any],
E               selected: Sequence[Mapping[str, Any]],
E           ) -> bool:
E               """Conservative independent veto over the provider's entailment judgment.
E           
E               Every published claim must name an admitted citation and introduce no
E               material term absent from that cited source, modulo closed equivalents.
E               The ordinary verifier and pinned citation checks remain mandatory.
E               """
E               claims = verification.get("answer_claims")
E               citations = verification.get("citations")
E               if not isinstance(claims, list) or not claims:
E                   return False
E               if not isinstance(citations, list) or not citations:
E                   return False
E               admitted = {str(item.get("evidence_id", "")): item for item in selected}
E               by_citation = {
E                   str(citation.get("citation_id", "")): admitted.get(
E                       str(citation.get("evidence_id", ""))
E                   )
E                   for citation in citations
E                   if isinstance(citation, Mapping)
E               }
E               cited_evidence: list[Mapping[str, Any]] = []
E               for claim in claims:
E                   if not isinstance(claim, Mapping):
E                       return False
E                   content = str(claim.get("surface_text") or "").strip()
E                   ids = claim.get("citation_ids")
E                   if not content or not isinstance(ids, list) or not ids:
E                       return False
E                   sources = [by_citation.get(str(cid)) for cid in ids]
E                   if any(source is None for source in sources):
E                       return False
E                   support = _production_grounding_terms(
E                       " ".join(str(source.get("passage_text") or "") for source in sources)
E                   )
E                   terms = _production_grounding_terms(content)
E                   if not terms or not terms.issubset(support):
E                       return False
E                   cited_evidence.extend(source for source in sources if source is not None)
E               published = str(verification.get("answer_text") or "")
E               published = re.sub(r"\[claim_\d+_ref_\d+\]", "", published)
E               answer_terms = _production_grounding_terms(published)
E               all_support = _production_grounding_terms(
E                   " ".join(str(source.get("passage_text") or "") for source in cited_evidence)
E               )
E               return bool(answer_terms) and answer_terms.issubset(all_support)
E           
E           
E           def _bound_evidence(
E               *,
E               output: object,
E               catalog: Mapping[str, Mapping[str, Any]],
E           ) -> tuple[dict[str, Any], ...]:
E               evidence: list[dict[str, Any]] = []
E               for item in getattr(output, "items", ()):
E                   source = catalog.get(item.knowledge_id)
E                   if source is None:
E                       continue
E                   if (
E                       not item.source_identity
E                       or not item.locator_id
E                       or source.get("source_identity") != item.source_identity
E                       or source.get("locator_id") != item.locator_id
E                   ):
E                       continue
E                   raw = source.get("passage_text")
E                   if not isinstance(raw, str) or not raw:
E                       continue
E                   if hashlib.sha256(raw.encode("utf-8")).hexdigest() != source.get("passage_text_sha256"):
E                       continue
E                   if not source.get("artifact_sha256") or not source.get("provenance_record_sha256"):
E                       continue
E                   evidence.append(dict(source))
E               return tuple(evidence)
E           
E           
E           def _compile_synthetic(
E               *,
E               evidence: Sequence[Mapping[str, Any]],
E               request_id: str,
E               policy: Mapping[str, Any],
E               release: Mapping[str, Any],
E           ) -> tuple[dict[str, Any], tuple[dict[str, Any], ...]]:
E               # M26.3 is synthetic-only by contract. Never treat this as production context.
E               unique: dict[str, dict[str, Any]] = {}
