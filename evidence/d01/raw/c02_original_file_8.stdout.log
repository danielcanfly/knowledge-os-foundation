E           def _release_for_compiler(request: M27ExecutableRequest) -> Mapping[str, Any]:
E               authority = request.production_evidence_authority
E               if authority is not None:
E                   return {
E                       "schema_version": "knowledge-engine-m27-production-evidence-bridge/v1",
E                       "release_id": authority.release_id,
E                       "manifest_sha256": authority.manifest_sha256,
E                   }
E               return {"release_id": "isolated-synthetic"}
