# M27 isolated runtime env template.
# Copy to a private path outside git and pass with M27_RUNTIME_ENV_FILE=<private-file>.
# Do not point this file at production writable credentials or production DB files.
KNOWLEDGE_ENGINE_ROOT=/app
M26_PUBLIC_QUOTA_DB=/var/lib/knowledge-engine/cache/m27-quota.sqlite3
M26_PUBLIC_IP_HMAC_SECRET=<non-production-random-hmac-secret>
M26_PUBLIC_PRELOAD_ANSWER_BUNDLE=0
M26_PUBLIC_PROVIDER_BUDGET_GUARD_ACTIVE=false
# Keep owner/admin/write-capable credentials unset unless explicitly approved for an isolated lab.
# KNOWLEDGE_ENGINE_OWNER_SUBJECT_HASH intentionally unset for health-only readiness.
