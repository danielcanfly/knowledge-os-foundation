# M27 isolated runtime env template.
# Copy to a private path outside git and pass with M27_RUNTIME_ENV_FILE=/path/to/private.env.m27.
# Do not point this file at production writable credentials or production DB files.
KNOWLEDGE_ENGINE_ROOT=/app
M26_PUBLIC_QUOTA_DB=/var/lib/knowledge-engine/public-api/m27-quota.sqlite3
# Keep owner/admin/write-capable credentials unset unless explicitly approved for an isolated lab.
